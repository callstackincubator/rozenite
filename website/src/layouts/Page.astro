---
// Minimal shell for the pages that live outside Starlight (home, plugin directory, welcome).
// A later step restyles these.
const { title, description = 'Plug-and-play DevTools panels for React Native and Lynx.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:image" content="https://rozenite.dev/og-image.jpg" />
    <link rel="icon" href="/logo.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
