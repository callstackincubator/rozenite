---
// Header links: mono, uppercase, text only.
const links = [
  { label: 'Plugins', href: '/plugin-directory' },
  { label: 'GitHub', href: 'https://github.com/callstackincubator/rozenite', external: true },
  { label: 'Discord', href: 'https://discord.gg/xgGt7KAjxv', external: true },
];
---

{
  links.map(({ label, href, external }) => (
    <a href={href} class="cs-header-link" rel={external ? 'me noopener' : undefined}>
      {label}
      {external && <span aria-hidden="true">↗</span>}
    </a>
  ))
}

<style>
  .cs-header-link {
    font-family: var(--cs-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--cs-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .cs-header-link:hover {
    color: var(--sl-color-white);
  }
  .cs-header-link span {
    margin-inline-start: 0.25em;
  }
</style>
