---
// A plugin's two halves either side of the bridge, on the traffic scene. The panel asks for the
// user, the app side's handler lights up and answers, the panel fills in. Messages step across
// the duct both ways, as typed events.
import CodeBlock from '../site/CodeBlock.astro';
import DevTools from '../site/DevTools.astro';
import Dither from '../site/Dither.astro';
import Window from '../site/Window.astro';

const appSide = `import { DevToolsPluginClient } from '@rozenite/plugin-bridge';

export default function setupPlugin(
  client: DevToolsPluginClient<PluginEvents>
) {
  client.onMessage('request-user-data', () => {
    client.send('user-data', {
      id: 'user-123',
      name: 'John Doe',
      email: 'john@example.com',
    });
  });
}`;
---

<div
  class="anatomy"
  data-anatomy
  role="img"
  aria-label="The plugin's panel in DevTools sends request-user-data. The app side's onMessage handler runs and sends user-data back, and the panel shows the user's id, name and email."
>
  <Dither scene="traffic" />
  <div class="an-rig">
    <Window title="react-native.ts" class="an-code">
      <CodeBlock code={appSide} lang="ts" wrap />
    </Window>
    <div class="duct" data-duct>
      <span class="pkt" data-pkt></span>
      <span class="pkt pkt--back" data-pkt-back></span>
    </div>
    <DevTools tabs={[{ id: 'mine', label: 'My Custom Panel', plugin: true }]} selected="mine" class="an-panel">
      <div class="pane is-on" style="--cols: 4.5rem minmax(0,1fr)">
        <div class="pane-row pane-head"><span>Field</span><span>Value</span></div>
        <div class="pane-row"><span class="dim">id</span><span data-field>user-123</span></div>
        <div class="pane-row"><span class="dim">name</span><span data-field>John Doe</span></div>
        <div class="pane-row"><span class="dim">email</span><span data-field>john@example.com</span></div>
        <div class="log">
          <div class="pane-row" data-row="out"><span class="dim">→</span><span>request-user-data</span></div>
          <div class="pane-row" data-row="in"><span class="live">←</span><span>user-data</span></div>
        </div>
      </div>
    </DevTools>
  </div>
</div>

<script>
  import { whenNear } from '../site/lazy';

  const root = document.querySelector<HTMLElement>('[data-anatomy]');
  if (root) whenNear(root, () => void import('./anatomy').then((m) => m.default(root)));
</script>

<style>
  .anatomy {
    position: relative;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .an-rig {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 3.5rem) var(--pad);
  }
  .an-rig :global(.an-code) {
    flex: 0 1 30rem;
  }
  .an-rig :global(.an-code .line.is-hot) {
    background: rgb(var(--accent-rgb) / 0.14);
  }
  .an-rig :global(.an-panel) {
    flex: 0 1 22rem;
    height: 17rem;
  }
  [data-field] {
    visibility: hidden;
  }
  [data-field].is-on {
    visibility: visible;
  }
  .log {
    margin-top: auto;
    border-top: 1px solid var(--line);
  }
  .log .pane-row:last-child {
    border-bottom: 0;
  }
  @media (max-width: 48rem) {
    .an-rig {
      flex-direction: column;
    }
    .an-rig :global(.an-code),
    .an-rig :global(.an-panel) {
      flex: none;
      width: 100%;
    }
  }
</style>
