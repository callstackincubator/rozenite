---
// Variant A's hero: one running app between its two views. On the left React Native DevTools,
// the human's view, where the Network Activity panel fills with the app's requests. On the
// right the agent's terminal, where the same failing request comes back from
// `network · listRequests`. A device serves one debugger connection at a time, so the two take
// turns: the idle side dims while the other is attached.
import CopyCommand from '../site/CopyCommand.astro';
import DevTools from '../site/DevTools.astro';
import Dither from '../site/Dither.astro';
import Phone from '../site/Phone.astro';
import Window from '../site/Window.astro';
import { docs, site } from '../../site/content';

const products = [
  { name: 'Runner Low', price: '$120', art: 'a' },
  { name: 'Cotton Tee', price: '$32', art: 'b' },
  { name: 'Field Cap', price: '$24', art: 'c' },
];
const tabs = [
  { id: 'console', label: 'Console' },
  { id: 'network', label: 'Network Activity', plugin: true },
  { id: 'storage', label: 'Storage', plugin: true },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-top hero-top--split">
    <div class="hero-copy">
      <h1 class="h1" id="hero-title">See inside your running app. <em>So can your agent.</em></h1>
      <p class="lede">
        Rozenite puts plugin panels in React Native DevTools for you, and gives your coding agent the same data as tools it
        calls from the terminal: logs, network requests, React profiles and plugin state.
      </p>
      <div class="actions">
        <a class="btn" href={docs.start}>Get started <span aria-hidden="true">→</span></a>
        <CopyCommand command={site.install} />
      </div>
    </div>
    <Window title="zsh" class="hero-side">
      <div class="term">
        <div class="ln"><span class="p">$</span> npx rozenite@latest init</div>
        <div class="ln"><span class="p">$</span> npm install -D @rozenite/network-activity-plugin</div>
        <div class="ln dim"># for you: press j to open React Native DevTools</div>
        <div class="ln">
          <span class="p">$</span> {site.skill.replace(' --skill rozenite', '')} <span class="nw">--skill rozenite</span>
        </div>
        <div class="ln dim"># for your agent: the rozenite skill</div>
      </div>
    </Window>
  </div>

  <div
    class="viz"
    data-hero-panels
    role="img"
    aria-label="One running app with two views. In React Native DevTools, the Network Activity panel shows the app's requests, including a failing GET /api/cart. Then a coding agent attaches from the terminal, lists the same requests, finds the same failing request and the error behind it."
  >
    <Dither scene="crystals" focus={0.5} />
    <div class="rig">
      <DevTools tabs={tabs} selected="network" class="rig-devtools">
        <div class="pane is-on" data-pane="network" style="--cols: 2.75rem minmax(0,1fr) 2.75rem 3.75rem">
          <div class="pane-row pane-head"><span>Method</span><span>URL</span><span>Status</span><span>Time</span></div>
          <div class="pane-row" data-row="n0"><span>GET</span><span>/api/products</span><span class="mut">200</span><span class="mut">142 ms</span></div>
          <div class="pane-row" data-row="n1"><span>GET</span><span>/api/user</span><span class="mut">200</span><span class="mut">88 ms</span></div>
          <div class="pane-row" data-row="n2"><span>GET</span><span>/api/cart</span><span>500</span><span class="mut">212 ms</span></div>
        </div>
      </DevTools>

      <div class="duct" data-duct-human><span class="pkt" data-pkt-human></span></div>

      <Phone title="Store" count={2} class="rig-phone">
        <div class="view is-on" data-view="home">
          <ul class="store">
            {
              products.map((p) => (
                <li class="item">
                  <span class:list={['art', `art-${p.art}`]} />
                  <span class="item-name">{p.name}</span>
                  <span class="item-price">{p.price}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="view" data-view="cart">
          <div class="err">
            <span class="label">Error</span>
            <p>Couldn’t load your cart.</p>
          </div>
        </div>
      </Phone>

      <div class="duct" data-duct-agent>
        <span class="pkt" data-pkt-agent></span>
        <span class="pkt pkt--back" data-pkt-call></span>
      </div>

      <Window title="agent" class="rig-agent">
        <div class="term" data-term></div>
      </Window>
    </div>
  </div>
</section>

<script>
  import { whenNear } from '../site/lazy';

  const root = document.querySelector<HTMLElement>('[data-hero-panels]');
  if (root) whenNear(root, () => void import('./panels').then((m) => m.default(root)));
</script>

<style>
  .hero-top--split {
    grid-template-columns: minmax(0, 1fr) 24rem;
    align-items: center;
    padding-block: clamp(2rem, 4.5vw, 3.75rem);
  }
  .hero-top--split .h1 {
    max-width: 16ch;
  }
  :global(.hero-side) .term {
    font-size: 0.75rem;
    overflow-wrap: normal;
  }
  .nw {
    white-space: nowrap;
  }
  .rig {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 3.5rem) var(--pad);
  }
  .rig :global(.rig-devtools) {
    flex: 1 1 22rem;
    max-width: 26rem;
    height: 15rem;
  }
  .rig :global(.rig-agent) {
    flex: 1 1 22rem;
    max-width: 26rem;
    min-height: 15rem;
  }
  .rig :global(.rig-agent) .term {
    font-size: 0.6875rem;
    line-height: 1.65;
  }
  .rig .duct {
    max-width: 4.5rem;
  }
  .rig :global(.rig-phone) {
    --w: 11.5rem;
  }

  .view {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .view.is-on {
    opacity: 1;
  }
  .store {
    margin: 0;
    padding: 0.5rem 0.75rem;
    list-style: none;
  }
  .item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: 0.5rem;
    align-items: center;
    padding: 0.4375rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.6875rem;
  }
  .art {
    grid-row: span 2;
    width: 1.5rem;
    aspect-ratio: 1;
    background-color: var(--field);
    background-size: 4px 4px;
  }
  .art-a {
    background-image: radial-gradient(rgb(var(--accent-rgb) / 0.9) 1px, transparent 1.2px);
  }
  .art-b {
    background-image: radial-gradient(rgb(255 255 255 / 0.55) 1px, transparent 1.2px);
  }
  .art-c {
    background-image: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.6) 1.5px, transparent 1.5px);
  }
  .item-price {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--muted);
  }
  /* An error, drawn without the accent: status never borrows the brand colour. */
  .err {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0.75rem;
    padding: 0.625rem;
    border: 1px solid var(--line-strong);
    background: #0d0d0d;
    font-size: 0.75rem;
  }
  .err .label {
    font-size: 0.5625rem;
    color: var(--faint);
  }
  .err p {
    margin: 0;
  }

  @media (max-width: 64rem) {
    .hero-top--split {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.hero-side) {
      display: none;
    }
    /* Too narrow for three across: the two views stack, the app between them. */
    .rig {
      flex-direction: column;
    }
    .rig :global(.rig-devtools),
    .rig :global(.rig-agent) {
      flex: none;
      width: min(100%, 30rem);
      max-width: none;
    }
    .rig :global(.rig-agent) {
      min-height: 0;
    }
    .rig .duct {
      flex: 0 0 2.5rem;
      width: 2.25rem;
      min-width: 0;
      height: 2.5rem;
      max-width: none;
      background: repeating-linear-gradient(180deg, var(--track) 0 4px, transparent 4px 8px) center / 2px 100% no-repeat;
    }
    .rig .duct :global(.pkt) {
      top: 0;
      left: 50%;
    }
    .rig :global(.rig-devtools) {
      height: 12.5rem;
    }
    .rig :global(.rig-phone) {
      --w: 9.5rem;
    }
  }
</style>
