---
// Variant C's hero, build-led: the app side of a plugin you write, at the top, feeds two views
// below it. Its message handler fills a panel in React Native DevTools (the human's view); its
// agent tool answers the agent in the terminal (the agent's view). Same `getCart()` behind both.
// One debugger connection at a time, so the two take turns.
import CodeBlock from '../site/CodeBlock.astro';
import CopyCommand from '../site/CopyCommand.astro';
import DevTools from '../site/DevTools.astro';
import Dither from '../site/Dither.astro';
import Window from '../site/Window.astro';
import { docs, site } from '../../site/content';

// The plugin's app side, in two halves: the handler that feeds the panel, the tool for agents.
const forPanel = `export default function setupPlugin(client) {
  client.onMessage('get-cart', () => {
    client.send('cart', getCart());
  });
}`;
const forAgent = `export function CheckoutAgentTools() {
  useRozenitePluginAgentTool({
    pluginId: '@acme/checkout-inspector',
    tool: getCartTool,
    handler: () => getCart(),
  });
  return null;
}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-top hero-top--c">
    <div class="hero-copy">
      <h1 class="h1" id="hero-title">One plugin. <em>A panel for you, tools for your agent.</em></h1>
      <p class="lede">
        Write a Rozenite plugin once: its app side feeds a panel in React Native DevTools and registers tools your coding
        agent calls. Start from the fourteen official plugins; seven of them already give agents tools.
      </p>
      <div class="actions">
        <a class="btn" href={docs.pluginDev}>Build a plugin <span aria-hidden="true">→</span></a>
        <CopyCommand command={site.install} />
      </div>
    </div>
  </div>

  <div
    class="viz"
    data-hero-build
    role="img"
    aria-label="The app side of a checkout-inspector plugin. Its message handler sends the cart to a Checkout Inspector panel in React Native DevTools, which lists two products. Then a coding agent calls the plugin's get-cart tool from the terminal and gets the same two products back."
  >
    <Dither scene="crystals" focus={0.5} />
    <div class="tree">
      <Window title="checkout-inspector/react-native.ts" class="tree-code">
        <div class="halves">
          <div class="half" data-half="panel"><CodeBlock code={forPanel} lang="ts" wrap /></div>
          <div class="half half--b" data-half="agent"><CodeBlock code={forAgent} lang="ts" wrap /></div>
        </div>
      </Window>
      <div class="duct duct--v duct--h" data-duct-human><span class="pkt" data-pkt-human></span></div>
      <div class="duct duct--v duct--a" data-duct-agent>
        <span class="pkt" data-pkt-agent></span>
        <span class="pkt pkt--back" data-pkt-call></span>
      </div>
      <DevTools
        tabs={[
          { id: 'console', label: 'Console' },
          { id: 'mine', label: 'Checkout Inspector', plugin: true },
        ]}
        selected="mine"
        class="tree-devtools"
      >
        <div class="pane is-on" style="--cols: minmax(0,1fr) 2.5rem 3.5rem">
          <div class="pane-row pane-head"><span>Product</span><span>Qty</span><span>Price</span></div>
          <div class="pane-row" data-row><span>Runner Low</span><span class="mut">1</span><span>$120</span></div>
          <div class="pane-row" data-row><span>Cotton Tee</span><span class="mut">2</span><span>$64</span></div>
          <div class="pane-row" data-row><span class="mut">Total</span><span></span><span>$184</span></div>
        </div>
      </DevTools>
      <Window title="agent" class="tree-agent">
        <div class="term" data-term></div>
      </Window>
    </div>
  </div>
</section>

<script>
  import { whenNear } from '../site/lazy';

  const root = document.querySelector<HTMLElement>('[data-hero-build]');
  if (root) whenNear(root, () => void import('./build').then((m) => m.default(root)));
</script>

<style>
  .hero-top--c {
    justify-items: center;
    text-align: center;
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }
  .hero-top--c .hero-copy {
    align-items: center;
  }
  .hero-top--c .h1 {
    max-width: 20ch;
  }
  .hero-top--c .lede {
    max-width: 40rem;
  }
  .hero-top--c .actions {
    justify-content: center;
  }

  /* A tree: the plugin at the top, branching down into its two views. */
  .tree {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 24rem));
    justify-content: center;
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3rem) var(--pad);
  }
  .tree :global(.tree-code) {
    grid-column: 1 / -1;
  }
  /* The two halves of the file, each above the view it feeds. */
  .halves {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .half {
    min-width: 0;
    transition: background-color 0.3s steps(3);
  }
  .half + .half {
    border-left: 1px solid var(--line);
  }
  .half :global(.astro-code) {
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .half--b :global(code) {
    counter-reset: line 6;
  }
  .half.is-hot {
    background: rgb(var(--accent-rgb) / 0.1);
  }
  .duct--v {
    flex: none;
    justify-self: center;
    width: 2.25rem;
    min-width: 0;
    max-width: none;
    height: 2.5rem;
    background: repeating-linear-gradient(180deg, var(--track) 0 4px, transparent 4px 8px) center / 2px 100% no-repeat;
  }
  .duct--v :global(.pkt) {
    top: 0;
    left: 50%;
  }
  .tree :global(.tree-devtools) {
    height: 13.25rem;
  }
  .tree :global(.tree-agent) {
    min-height: 11rem;
  }
  .tree :global(.tree-agent) .term {
    font-size: 0.6875rem;
    line-height: 1.65;
  }

  @media (max-width: 48rem) {
    /* Stacked: the plugin, then its panel, then the agent's terminal. */
    .tree {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
    .halves {
      grid-template-columns: minmax(0, 1fr);
    }
    .half + .half {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .duct--a {
      display: none;
    }
    .tree :global(.tree-agent) {
      margin-top: 1.25rem;
      min-height: 0;
    }
    .tree > :global(*) {
      grid-column: 1 !important;
    }
    .duct--h {
      order: 1;
    }
    .tree :global(.tree-code) {
      order: 0;
    }
    .tree :global(.tree-devtools) {
      order: 2;
    }
    .tree :global(.tree-agent) {
      order: 3;
    }
  }
</style>
