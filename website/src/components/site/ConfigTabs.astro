---
// One tab per bundler or target, each a window with the real config over a flow backdrop and a
// strip with the package, a line about it and its setup link.
import { code, docs } from '../../site/content';
import CodeBlock from './CodeBlock.astro';
import Dither from './Dither.astro';
import Window from './Window.astro';

const tabs = [
  {
    id: 'metro',
    name: 'Metro',
    file: 'metro.config.js',
    lang: 'js',
    code: code.metro,
    pkg: '@rozenite/metro',
    note: 'Expo or bare React Native, with the bundler React Native ships.',
    href: docs.start,
  },
  {
    id: 'repack',
    name: 'Re.Pack',
    file: 'rspack.config.mjs',
    lang: 'js',
    code: code.repack,
    pkg: '@rozenite/repack',
    note: 'Re.Pack 5.2 and above.',
    href: docs.start,
  },
  {
    id: 'web',
    name: 'Web',
    file: 'metro.config.js',
    lang: 'js',
    code: code.web,
    pkg: '@rozenite/web',
    note: 'React Native Web in a Chromium browser, with the Rozenite extension. Experimental.',
    href: docs.web,
  },
  {
    id: 'lynx',
    name: 'Lynx',
    file: 'lynx.config.ts',
    lang: 'ts',
    code: code.lynx,
    pkg: '@rozenite/lynx',
    note: 'Lynx apps through rspeedy, with Lynx DevTool turned on in the app. Experimental.',
    href: docs.lynx,
  },
];
---

<div class="tabs" data-tabs>
  <div class="tab-bar" role="tablist" aria-label="Bundler or target">
    {
      tabs.map((t, i) => (
        <button
          class="tab label"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.name}
        </button>
      ))
    }
  </div>
  <div class="cfg-stage">
    <Dither scene="flow" />
    {
      tabs.map((t, i) => (
        <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
          <Window title={t.file} class="cfg-window">
            <CodeBlock code={t.code} lang={t.lang} minLines={10} />
          </Window>
          <div class="panel-foot">
            <code class="pkg">{t.pkg}</code>
            <span class="body">{t.note}</span>
            <a class="label more" href={t.href}>
              Set up {t.name} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  // Tabs: click, or arrow keys along the tab bar (WAI-ARIA tabs pattern).
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length]!;
        select(next);
        next.focus();
      });
    });
  }
</script>

<style>
  .cfg-stage {
    position: relative;
    padding: clamp(2.5rem, 7vw, 5.5rem) var(--pad) 0;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .panel {
    position: relative;
  }
  .panel :global(.cfg-window) {
    max-width: 46rem;
    margin: 0 auto clamp(2.5rem, 7vw, 5.5rem);
  }
  .panel-foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    margin-inline: calc(-1 * var(--pad));
    padding: 1rem var(--pad);
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .panel-foot .body {
    flex: 1;
    min-width: 14rem;
  }
</style>
