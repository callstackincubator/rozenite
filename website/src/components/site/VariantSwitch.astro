---
// Prototype only: a fixed A/B/C switcher between the landing page variants.
interface Props {
  current: 'a' | 'b' | 'c';
}
const { current } = Astro.props;
---

<nav class="variant-switch label" aria-label="Landing page variants">
  <a href="/variants" title="All variants">All</a>
  {
    (['a', 'b', 'c'] as const).map((v) => (
      <a href={`/variants/${v}`} aria-current={v === current ? 'page' : undefined}>
        {v.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  /* Room under the footer, so the switcher never covers its links on a phone. */
  @media (max-width: 48rem) {
    :global(body) {
      padding-bottom: 3.5rem;
    }
  }
  .variant-switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }
  .variant-switch a {
    padding: 0.5rem 0.75rem;
    color: var(--muted);
    text-decoration: none;
    border-right: 1px solid var(--line);
  }
  .variant-switch a:last-child {
    border-right: 0;
  }
  .variant-switch a:hover {
    color: var(--text);
  }
  .variant-switch a[aria-current='page'] {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
