{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo run build --filter=@rozenite/docs",
  "cleanUrls": true,
  "framework": null,
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/docs/rozenite-for-lynx",
      "destination": "/docs/targets/rozenite-for-lynx",
      "permanent": true
    },
    {
      "source": "/docs/rozenite-for-web",
      "destination": "/docs/targets/rozenite-for-web",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/404.html"
    }
  ],
  "outputDirectory": "build",
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": false
  }
}
