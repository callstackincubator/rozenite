{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "paths": {
      "@rozenite/ui": ["packages/ui/src/index.ts"],
      "@rozenite/ui/*": ["packages/ui/*"]
    },
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"]
  }
}
