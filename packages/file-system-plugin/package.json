{
  "name": "@rozenite/file-system-plugin",
  "version": "2.4.0",
  "description": "A Rozenite plugin for browsing app files and previewing file contents in React Native DevTools.",
  "homepage": "https://github.com/callstackincubator/rozenite#readme",
  "bugs": {
    "url": "https://github.com/callstackincubator/rozenite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/rozenite.git"
  },
  "type": "module",
  "main": "./dist/react-native/cjs/react-native.js",
  "module": "./dist/react-native/react-native.js",
  "types": "./dist/react-native/react-native.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/react-native.d.ts",
      "import": "./dist/react-native/react-native.js",
      "require": "./dist/react-native/cjs/react-native.js"
    },
    "./package.json": "./package.json",
    "./sdk": {
      "development": "./sdk.ts",
      "types": "./dist/sdk/sdk.d.ts",
      "default": "./dist/sdk/sdk.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rozenite build",
    "dev": "rozenite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@rozenite/agent-bridge": "workspace:*",
    "@rozenite/agent-shared": "workspace:*",
    "@rozenite/plugin-bridge": "workspace:*",
    "@rozenite/ui": "workspace:*"
  },
  "devDependencies": {
    "@rozenite/test-utils": "workspace:*",
    "@rozenite/vite-plugin": "workspace:*",
    "@types/react": "catalog:",
    "lucide-react": "^0.263.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-web": "^0.21.2",
    "rozenite": "workspace:*",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
}
