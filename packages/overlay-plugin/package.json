{
  "name": "@rozenite/overlay-plugin",
  "version": "1.13.0",
  "description": "Grid and image overlay plugin for Rozenite.",
  "type": "module",
  "main": "./dist/react-native/index.cjs",
  "module": "./dist/react-native/index.js",
  "types": "./dist/react-native/index.d.ts",
  "homepage": "https://github.com/callstackincubator/rozenite#readme",
  "bugs": {
    "url": "https://github.com/callstackincubator/rozenite/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/rozenite.git"
  },
  "scripts": {
    "build": "rozenite build",
    "dev": "rozenite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@rozenite/plugin-bridge": "workspace:*",
    "@rozenite/ui": "workspace:*"
  },
  "devDependencies": {
    "@rozenite/vite-plugin": "workspace:*",
    "@types/react": "catalog:",
    "lucide-react": "^0.263.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "rozenite": "workspace:*",
    "typescript": "~5.9.3",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js",
      "require": "./dist/react-native/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
