{
  "name": "@rozenite/test-utils",
  "version": "2.6.0",
  "private": true,
  "description": "Internal testing utilities for Rozenite packages. Not published.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./packaging": {
      "types": "./src/packaging/index.d.mts",
      "default": "./src/packaging/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "devDependencies": {
    "@react-native/metro-config": "~0.88.0",
    "expo": "^58.0.19",
    "metro": "0.87.1",
    "metro-config": "0.87.1",
    "react-native": "catalog:",
    "typescript": "~5.8.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
