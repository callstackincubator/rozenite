{
  "name": "@rozenite/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Internal testing utilities for Rozenite packages. Not published.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "devDependencies": {
    "@react-native/metro-config": "~0.86.0",
    "expo": "^57.0.7",
    "metro": "0.84.4",
    "metro-config": "0.84.4",
    "react-native": "catalog:",
    "typescript": "~5.8.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
