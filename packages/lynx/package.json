{
  "name": "@rozenite/lynx",
  "version": "2.3.0",
  "description": "Rozenite device runtime for Lynx.",
  "keywords": [
    "devtools",
    "lynx",
    "plugin",
    "rozenite"
  ],
  "homepage": "https://github.com/callstackincubator/rozenite#readme",
  "bugs": {
    "url": "https://github.com/callstackincubator/rozenite/issues"
  },
  "license": "MIT",
  "author": "Szymon Chmal <szymon.chmal@callstack.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/rozenite.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
