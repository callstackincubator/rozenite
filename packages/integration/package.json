{
  "name": "@rozenite/integration",
  "version": "2.2.0",
  "description": "Host integration abstraction for Rozenite: what differs between serving React Native and Lynx.",
  "keywords": [
    "bundler",
    "devtools",
    "integration",
    "lynx",
    "react-native",
    "rozenite"
  ],
  "homepage": "https://github.com/callstackincubator/rozenite#readme",
  "bugs": {
    "url": "https://github.com/callstackincubator/rozenite/issues"
  },
  "license": "MIT",
  "author": "Szymon Chmal <szymon.chmal@callstack.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/rozenite.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@rozenite/tools": "workspace:*",
    "semver": "^7.7.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@react-native/dev-middleware": "~0.76.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "vitest": "^4.0.18",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
