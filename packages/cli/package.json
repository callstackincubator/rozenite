{
  "name": "rozenite",
  "version": "2.0.0",
  "description": "Command-line interface for creating and managing React Native DevTools plugins",
  "keywords": [
    "cli",
    "devtools",
    "generator",
    "plugin",
    "react-native"
  ],
  "homepage": "https://github.com/callstackincubator/rozenite#readme",
  "bugs": {
    "url": "https://github.com/callstackincubator/rozenite/issues"
  },
  "license": "MIT",
  "author": "Szymon Chmal <szymon.chmal@callstack.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/rozenite.git"
  },
  "bin": {
    "rozenite": "./bin.js"
  },
  "files": [
    "dist",
    "skills",
    "template",
    "bin.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@rozenite/agent-sdk": "workspace:*",
    "@rozenite/agent-shared": "workspace:*",
    "@rozenite/tools": "workspace:*",
    "commander": "^14.0.0",
    "ejs": "^3.1.10",
    "is-unicode-supported": "^2.1.0",
    "nano-spawn": "^1.0.2",
    "picocolors": "^1.1.1",
    "validate-npm-package-name": "^6.0.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/validate-npm-package-name": "^4.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
