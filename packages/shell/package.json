{
  "name": "@rozenite/shell",
  "version": "2.1.0",
  "description": "Unified Rozenite panel shell for React Native DevTools.",
  "keywords": [
    "devtools",
    "plugin",
    "react-native",
    "shell"
  ],
  "homepage": "https://github.com/callstackincubator/rozenite#readme",
  "bugs": {
    "url": "https://github.com/callstackincubator/rozenite/issues"
  },
  "license": "MIT",
  "author": "Szymon Chmal <szymon.chmal@callstack.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/rozenite.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./testing": "./src/testing/host-conformance.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@rozenite/plugin-bridge": "workspace:*",
    "@rozenite/ui": "workspace:*",
    "lucide-react": "^0.263.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
